    {"id": "07_move_wrist", "audio": "results/safety/reasoner_flow10_audio/move_wrist.wav", "audio_source": "new_windows_offline_tts", "reference": "先向左移动五毫米，再把手腕向下转三度", "goal": "move_wrist", "route": "planner", "delta_mm": [0, 5, 0], "wrist_deg": 3, "expected": {"steps": [{"action": "move", "axis": "y", "mm": 5}, {"action": "wrist", "deg": 3}]}},
    {"id": "08_transfer_C_A", "audio": "results/safety/reasoner_flow10_audio/transfer_c_a.wav", "audio_source": "new_windows_offline_tts", "reference": "把C区的红色木块放到左边的工位", "goal": "transfer", "source": "C", "target": "A", "route": "planner", "expected": {"steps": [{"action": "transfer", "object": "red_1", "from": "C", "to": "A"}]}},
    {"id": "09_excess_distance", "audio": "results/safety/reasoner_flow10_audio/excess.wav", "audio_source": "new_windows_offline_tts", "reference": "向前移动六十厘米", "goal": "ask", "route": "planner", "ask_focus": [["范围", "限制", "超过", "超出", "50", "五十", "5厘米", "五厘米", "缩小", "距离"]], "expected": {"action": "ask", "question": "距离超过单步50毫米限制，请缩小距离。"}},
