    {"id": "02_left_12mm", "audio": "results/safety/prompt_trial_audio/move.wav", "audio_source": "reused_windows_offline_tts", "reference": "向左移动十二毫米", "goal": "move", "route": "planner", "delta_mm": [0, 12, 0], "expected": {"steps": [{"action": "move", "axis": "y", "mm": 12}]}},
    {"id": "03_negative", "audio": "results/safety/prompt_trial_audio/negative.wav", "audio_source": "reused_windows_offline_tts", "reference": "不要向前移动一厘米", "goal": "ignore", "route": "local", "expected": {"local": "ignore"}},
    {"id": "04_missing_unit", "audio": "results/safety/prompt_trial_audio/clarify.wav", "audio_source": "reused_windows_offline_tts", "reference": "向前移动五", "goal": "ask", "route": "local", "expected": {"local": "ask"}},
    {"id": "05_answer_5mm", "audio": "results/safety/reasoner_flow10_audio/answer.wav", "audio_source": "new_windows_offline_tts", "reference": "五毫米", "goal": "move", "route": "planner", "reply_to": "04_missing_unit", "delta_mm": [5, 0, 0], "expected": {"steps": [{"action": "move", "axis": "x", "mm": 5}]}},
